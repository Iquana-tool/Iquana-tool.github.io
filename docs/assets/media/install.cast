[0.018108, "o", "\u001b[?2004h\u001b]0;iml-ntw@msw-3188: /mnt/c/Users/role01-admin/PycharmProjects/iquana/iquana-tool\u0007\u001b[01;32miml-ntw@msw-3188\u001b[00m:\u001b[01;34m/mnt/c/Users/role01-admin/PycharmProjects/iquana/iquana-tool\u001b[00m$ "]
[7.609981, "o", "\u001b[7mCONTAINER_RUNTIME=podman ./install.sh\u001b[27m"]
[8.036704, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\bCONTAINER_RUNTIME=podman ./install.sh\r\n\u001b[?2004l\r"]
[8.053444, "o", "\r\n\u001b[1m  IQUANA installer\u001b[0m\r\n\u001b[2m  interactive annotation and quantification\u001b[0m\r\n\r\n"]
[8.053654, "o", "\u001b[36m==>\u001b[0m \u001b[1mChecking prerequisites\u001b[0m\r\n"]
[8.070989, "o", "    \u001b[32mgit 2.43.0\u001b[0m\r\n"]
[8.102969, "o", "    \u001b[32muv 0.12.5\u001b[0m\r\n"]
[8.140273, "o", "    \u001b[32mbun 1.4.0\u001b[0m\r\n"]
[8.803351, "o", "    \u001b[32mpodman (container runtime)\u001b[0m\r\n"]
[8.814762, "o", "\u001b[36m==>\u001b[0m \u001b[1mConfiguration\u001b[0m\r\n\r\n    Release channel:\r\n"]
[8.815032, "o", "      stable  -- the 'main' branch of every repository (recommended)\r\n      dev     -- the 'dev' branch where available; newer features, expect breakage\r\n"]
[8.815569, "o", "    channel (stable/dev)? \u001b[2m[stable]\u001b[0m "]
[10.281768, "o", "d"]
[10.39977, "o", "e"]
[10.601046, "o", "v"]
[10.89512, "o", "\r\n"]
[10.896235, "o", "\r\n    Hostname other machines use to reach this installation. Keep 'localhost'\r\n    unless you want to open IQUANA to your network -- it is baked into the\r\n    frontend's API URL and into the backend's allowed CORS origins.\r\n"]
[10.896744, "o", "    hostname or IP? \u001b[2m[localhost]\u001b[0m "]
[11.995831, "o", "\r\n"]
[11.996284, "o", "\r\n    If other people will sign in to this installation, you can name it and\r\n    say who to ask for an account. Both appear on the sign-in page.\r\n"]
[11.996962, "o", "    identify this instance to its users? \u001b[2m[y/N]\u001b[0m "]
[13.90998, "o", "y"]
[14.135333, "o", "\r\n"]
[14.138032, "o", "        e.g. 'HIFMB Reef Lab' -- shown as 'Welcome to ...'\r\n"]
[14.138466, "o", "    instance name? "]
[15.551201, "o", "T"]
[15.821138, "o", "e"]
[15.979041, "o", "s"]
[16.158726, "o", "t"]
[16.203675, "o", " "]
[16.429947, "o", "o"]
[16.43023, "o", "i"]
[16.608427, "o", "n"]
[16.676399, "o", "s"]
[16.970304, "o", "\b \b"]
[17.126505, "o", "\b \b"]
[17.26278, "o", "\b \b"]
[17.420407, "o", "\b \b"]
[17.622356, "o", "i"]
[17.824889, "o", "n"]
[17.892627, "o", "s"]
[18.071978, "o", "t"]
[18.252048, "o", "a"]
[18.365775, "o", "n"]
[18.409907, "o", "c"]
[18.590227, "o", "e"]
[18.74773, "o", "\r\n"]
[18.748196, "o", "        e.g. 'the Helmholtz Institute for Functional Marine Biodiversity'\r\n        -- shown as 'hosted by ...', so phrase it to follow that\r\n"]
[18.748714, "o", "    hosting organisation? "]
[20.119367, "o", "D"]
[20.277184, "o", "F"]
[20.38935, "o", "K"]
[20.523858, "o", "I"]
[20.9754, "o", "\r\n"]
[20.975947, "o", "        where people without an account should ask for one\r\n"]
[20.976667, "o", "    access contact (email)? "]
[22.080526, "o", "t"]
[22.30112, "o", "e"]
[22.503804, "o", "s"]
[22.683712, "o", "t"]
[23.426856, "o", "@"]
[23.719816, "o", "d"]
[23.876473, "o", "f"]
[24.034364, "o", "k"]
[24.169508, "o", "i"]
[24.416586, "o", "."]
[24.52953, "o", "d"]
[24.664875, "o", "e"]
[25.048834, "o", "\r\n"]
[25.049433, "o", "        optional one-line notice under the sign-in form, e.g. usage terms\r\n"]
[25.050111, "o", "    notice? "]
[26.487513, "o", "T"]
[26.644793, "o", "h"]
[26.847503, "o", "i"]
[26.959082, "o", "s"]
