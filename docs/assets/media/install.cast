[29.411338, "o", "l"]
[29.568432, "o", "l"]
[29.658449, "o", "a"]
[29.861553, "o", "t"]
[29.930603, "o", "i"]
[30.11022, "o", "o"]
[30.334438, "o", "n"]
[30.583603, "o", " "]
[30.717619, "o", "s"]
[30.829926, "o", "h"]
[31.010027, "o", "o"]
[31.054989, "o", "w"]
[31.257651, "o", "c"]
[31.414825, "o", "a"]
[31.57241, "o", "s"]
[31.708185, "o", "e"]
[31.933026, "o", "\r\n"]
[31.933632, "o", "\r\n    Self-registration lets anyone who can reach IQUANA create their own\r\n    account. With it off, you create accounts and hand them out. The first\r\n    account can always be created either way, so you are never locked out.\r\n"]
[31.934513, "o", "    allow self-registration? \u001b[2m[y/N]\u001b[0m "]
[33.889591, "o", "N"]
[34.204627, "o", "\r\n"]
[34.206702, "o", "\r\n    Ports (press Enter to accept the default):\r\n"]
[34.207181, "o", "    frontend (web UI) port? \u001b[2m[3000]\u001b[0m "]
[35.284916, "o", "\r\n"]
[35.289675, "o", "    backend (API) port? \u001b[2m[8000]\u001b[0m "]
[35.577056, "o", "\r\n"]
[35.582138, "o", "    ai-service port? \u001b[2m[8004]\u001b[0m "]
[35.846647, "o", "\r\n"]
[35.851856, "o", "    mlflow (model tracking) port? \u001b[2m[5000]\u001b[0m "]
[36.207017, "o", "\r\n"]
[36.211993, "o", "    postgres (database) port? \u001b[2m[5432]\u001b[0m "]
[36.611941, "o", "\r\n"]
[36.616617, "o", "    redis (task broker) port? \u001b[2m[6379]\u001b[0m "]
[37.018131, "o", "\r\n"]
[37.022775, "o", "\r\n"]
[37.094106, "o", "    An NVIDIA GPU was detected.\r\n    With CUDA the ai-service runs models on the GPU (several GB of extra\r\n    downloads). Without it everything still works, but inference and\r\n"]
[37.094287, "o", "    training fall back to the CPU and are much slower.\r\n    install with CUDA support? \u001b[2m[Y/n]\u001b[0m "]
[39.626845, "o", "Y"]
[40.775195, "o", "\r\n"]
[40.777196, "o", "\r\n    A HuggingFace access token lets the ai-service download gated model\r\n"]
[40.777274, "o", "    weights (SAM, DINOv3, ...). Create one at https://huggingface.co/settings/tokens\r\n    -- a read token is enough. You can leave this empty and add it later.\r\n"]
[40.777797, "o", "    HuggingFace token? \u001b[2m[leave empty to skip]\u001b[0m "]
[42.641111, "o", "\r\n"]
[42.641459, "o", "\r\n    Optional: an LLM API key enables the 'describe your label space' assistant\r\n"]
[42.641645, "o", "    in the frontend. Without it, label spaces are created manually.\r\n"]
[42.642171, "o", "    configure the label-space assistant? \u001b[2m[y/N]\u001b[0m "]
[43.993849, "o", "\r\n"]
[44.003787, "o", "    \u001b[32mwrote iquana.conf\u001b[0m\r\n\u001b[36m==>\u001b[0m \u001b[1mFetching repositories (dev channel)\u001b[0m\r\n"]
[44.500899, "o", "\r\n"]
[46.01329, "o", "    \u001b[32mbackend @ fed7e36 (dev)\u001b[0m\r\n"]
[48.614998, "o", "    \u001b[32mfrontend-react @ 1e6c037 (dev)\u001b[0m\r\n"]
[49.924561, "o", "    \u001b[32mai-service @ 8acdd33 (dev)\u001b[0m\r\n\u001b[36m==>\u001b[0m \u001b[1mWriting service configuration\u001b[0m\r\n"]
[49.937694, "o", "    kept the previous .env as .env.bak\r\n"]
[49.943221, "o", "    \u001b[32mbackend/.env\u001b[0m\r\n"]
[49.955477, "o", "    kept the previous .env as .env.bak\r\n"]
[49.960363, "o", "    \u001b[32mai-service/.env\u001b[0m\r\n"]
[49.972858, "o", "    kept the previous .env.local as .env.local.bak\r\n"]
[49.977184, "o", "    \u001b[32mfrontend-react/.env.local\u001b[0m\r\n\u001b[36m==>\u001b[0m \u001b[1mInstalling dependencies\u001b[0m\r\n"]
[49.977371, "o", "    This downloads several GB on a first install and can take a while.\r\n    syncing backend ...\r\n"]
[50.165565, "o", "\u001b[2mResolved \u001b[1m171 packages\u001b[0m \u001b[2min 2ms\u001b[0m\u001b[0m\r\n"]
[51.185508, "o", "\u001b[2mChecked \u001b[1m166 packages\u001b[0m \u001b[2min 394ms\u001b[0m\u001b[0m\r\n"]
[51.18854, "o", "    \u001b[32mbackend\u001b[0m\r\n    syncing ai-service ...\r\n"]
[51.340898, "o", "\u001b[2mResolved \u001b[1m219 packages\u001b[0m \u001b[2min 2ms\u001b[0m\u001b[0m\r\n"]
[52.470188, "o", "\u001b[2mChecked \u001b[1m185 packages\u001b[0m \u001b[2min 439ms\u001b[0m\u001b[0m\r\n"]
[52.473405, "o", "    \u001b[32mai-service\u001b[0m\r\n    installing frontend packages ...\r\n"]
[52.485054, "o", "\u001b[0m\u001b[2m[\u001b[1m2.33ms\u001b[0m\u001b[2m]\u001b[0m \u001b[2m\".env.local\"\u001b[0m\r\n"]
[55.49222, "o", "    \u001b[32mfrontend-react\u001b[0m\r\n\r\n"]
[55.492414, "o", "\u001b[36m==>\u001b[0m \u001b[1mReady\u001b[0m\r\n    frontend   http://localhost:3000\r\n    backend    http://localhost:8000  (API docs at /docs)\r\n    mlflow     http://localhost:5000\r\n\r\n    start / stop / status:   ./iquana.sh start | stop | status\r\n    logs:                    ./iquana.sh logs backend -f\r\n    update:                  ./install.sh\r\n"]
[55.492565, "o", "\r\n\u001b[33m warning:\u001b[0m no HuggingFace token was configured -- gated model weights will fail to download. Re-run ./install.sh --reconfigure to add one.\r\n\r\n"]
[55.497942, "o", "Start IQUANA now? \u001b[2m[Y/n]\u001b[0m "]
[55.499594, "o", "\r\n"]
[55.980006, "o", "\u001b[36m==>\u001b[0m \u001b[1mStarting IQUANA (dev channel)\u001b[0m\r\n"]
